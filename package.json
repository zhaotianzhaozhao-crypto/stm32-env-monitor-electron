{
  "name": "naijiaren",
  "productName": "奶家人",
  "private": true,
  "version": "1.3.10",
  "description": "基于 STM32 的环境监测 Electron 上位机（奶家人 — Electron + Vue3 + Three.js + MQTT）",
  "author": "奶家人",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win --dir",
    "mock:broker": "node scripts/mock-broker.mjs",
    "mock:stm32": "node scripts/mock-stm32.mjs",
    "mock:roundtrip": "node scripts/mqtt-roundtrip.mjs"
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.12.5",
    "mqtt": "^5.3.5",
    "three": "^0.160.0",
    "vue": "^3.4.15"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "aedes": "^1.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.0.11",
    "vite-plugin-electron": "^0.28.0"
  },
  "build": {
    "appId": "com.naijiaren.desktop",
    "productName": "奶家人",
    "copyright": "Copyright © 奶家人",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "shared",
        "to": "shared"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "奶家人",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "license": "installer/LICENSE.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "installer/nsis-hooks.nsh",
      "differentialPackage": false
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
